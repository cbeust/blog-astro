---
import { getCollection } from "astro:content";

interface Props {
  class?: string;
  limit?: number;
}

const { class: className = "", limit = 5 } = Astro.props;

const allPosts = await getCollection("posts");
allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const recentPosts = allPosts.slice(0, limit);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class={`rounded-xl border border-base-200 bg-white shadow-xs overflow-hidden ${className}`}>
  <div class="bg-[#f44365] px-4 py-2">
    <h4 class="text-[14px] font-normal uppercase tracking-[-0.04em] text-white">
      Recent Posts
    </h4>
  </div>
  <div class="p-4">
    <ul class="text-[13px] leading-snug space-y-1">
      {recentPosts.map((post) => (
        <li>
          <a
            href={`${basePath}/posts/${post.id}`}
            class="text-[#0071BB] hover:text-[#f44365] transition block"
          >
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
