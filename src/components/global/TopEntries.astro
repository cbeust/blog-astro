---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const topEntries = [
  {
    slug: "i-am-the-reason-for-hungarian-notation-in-android",
    title: "I am the reason for Hungarian notation in Android",
  },
  {
    slug: "dynamic-language-refactoring-ide-pick-one",
    title: "Dynamic language, refactoring: pick one",
  },
  {
    slug: "announcing-kobalt-1-0",
    title: "Announcing Kobalt 1.0",
  },
  {
    slug: "the-kobalt-diaries-templates",
    title: "The Kobalt diaries: Templates",
  },
  {
    slug: "hard-core-multicore-with-testng",
    title: "Hardcore multicore with TestNG",
  },
  {
    slug: "more-on-multithreaded-topological-sorting-2",
    title: "More on parallel topological sorting",
  },
  {
    slug: "return-of-the-statically-typed-languages",
    title: "The return of statically typed languages",
  },
  {
    slug: "structural-typing-vs-duck-typing",
    title: "Structural typing vs/ duck typing",
  },
  {
    slug: "agile-people-still-dont-get-it",
    title: "Agile people still don't get it",
  },
  {
    slug: "various-ways-to-get-randomness-wrong",
    title: "Various ways to get randomness wrong",
  },
  {
    slug: "coding-challenge",
    title: "Coding challenge",
  },
  {
    slug: "coding-challenge-wrap-up",
    title: "Coding challenge wrap up",
  },
];

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class={`rounded-xl border border-base-200 bg-white shadow-xs overflow-hidden ${className}`}>
  <div class="bg-[#f44365] px-4 py-2 border-b border-[#e02f51]">
    <h4 class="text-[14px] font-normal uppercase tracking-[-0.04em] text-white">
      Top entries
    </h4>
  </div>
  <div class="p-4">
    <ul class="divide-y divide-base-100 -my-1 text-[13px] leading-[150%]">
      {topEntries.map((entry) => (
        <li class="py-2 first:pt-0 last:pb-0">
          <a
            href={`${basePath}/posts/${entry.slug}`}
            class="text-[#0071BB] hover:text-[#f44365] transition block"
          >
            {entry.title}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
