---
import { Image } from "astro:assets";

interface Props {
  title: string;
  url: string;
  description?: string;
  pubDate: string;
  author?: string;
  image?: any;
  tags?: string[];
  alt?: string;
  commentCount?: number;
}

const {
  title,
  url,
  description = "",
  pubDate,
  author = "Cédric",
  image,
  tags = [],
  commentCount = 0,
} = Astro.props;
---

<article class="flex flex-col flex-1 h-full border border-base-200 rounded-2xl p-5 bg-white hover:border-base-400 transition shadow-xs">
  {image && (
    <a href={url} title={title} class="group block mb-4">
      <div class="block w-full overflow-hidden rounded-xl">
        <Image
          width={1200}
          height={630}
          src={image}
          alt={title}
          class="object-cover w-full h-full bg-center aspect-12/8 rounded-xl transition group-hover:scale-102"
        />
      </div>
    </a>
  )}

  <div class="flex flex-col flex-grow justify-between">
    <div>
      <div class="flex items-center space-x-1.5 text-xs text-base-500">
        <span class="font-medium text-base-700">{author}</span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={pubDate}>{pubDate}</time>
        {commentCount > 0 && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>💬 {commentCount}</span>
          </>
        )}
      </div>

      <h3 class="mt-2.5 text-lg font-medium text-base-900 leading-snug">
        <a href={url} class="hover:text-blue-600 transition">{title}</a>
      </h3>

      {description && (
        <p class="mt-2 text-sm text-base-500 line-clamp-3 leading-relaxed">{description}</p>
      )}
    </div>

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-base-100">
        {tags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="text-[11px] font-medium text-base-600 bg-base-50 hover:bg-base-100 px-2 py-0.5 rounded-full transition"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
