---
import BaseHead from "@/components/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";

interface Props {
  pageTitle?: string;
  description?: string;
}

const { pageTitle, description } = Astro.props;
---

<html lang="en" class="bg-[#EEEAD9]">
  <head>
    <BaseHead title={pageTitle} description={description} />
  </head>
  <body class="flex flex-col min-h-screen bg-[#EEEAD9] text-base-900 antialiased font-sans">
    <Navigation />
    <main class="flex-grow max-w-6xl w-full mx-auto px-6 sm:px-8"><slot /></main>
    <div class="max-w-6xl w-full mx-auto px-6 sm:px-8">
      <Footer />
    </div>
  </body>
</html>
