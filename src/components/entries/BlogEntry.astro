---
import { Image } from "astro:assets";
import DateBadge from "@/components/DateBadge.astro";

interface Props {
  title: string;
  url: string;
  description?: string;
  pubDate: string | Date;
  author?: string;
  image?: any;
  tags?: string[];
  alt?: string;
  commentCount?: number;
}

const {
  title,
  url,
  description = "",
  pubDate,
  author = "Cédric",
  image,
  tags = [],
  commentCount = 0,
} = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<article class="flex flex-col flex-1 h-full border border-base-200 rounded-2xl p-5 bg-base-50 hover:border-base-400 transition shadow-xs">
  {image && (
    <a href={url} title={title} class="group block mb-4">
      <div class="block w-full overflow-hidden rounded-xl">
        <Image
          width={1200}
          height={630}
          src={image}
          alt={title}
          class="object-cover w-full h-full bg-center aspect-12/8 rounded-xl transition group-hover:scale-102"
        />
      </div>
    </a>
  )}

  <div class="flex flex-col flex-grow justify-between">
    <div>
      <div class="flex items-start gap-3">
        <DateBadge date={pubDate} class="mt-0.5" />
        <div class="min-w-0 flex-1">
          <h3 class="text-lg font-medium text-base-900 leading-snug">
            <a href={url} class="hover:text-[#0071BB] transition">{title}</a>
          </h3>

          {commentCount > 0 && (
            <div class="text-xs text-base-500 mt-1.5">
              💬 {commentCount}
            </div>
          )}
        </div>
      </div>

      {description && (
        <p class="mt-2 text-sm text-base-600 line-clamp-3 leading-relaxed">{description}</p>
      )}
    </div>

    {tags?.filter((t) => t.toLowerCase() !== 'uncategorized').length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-base-200">
        {tags
          .filter((t) => t.toLowerCase() !== 'uncategorized')
          .map((tag) => (
            <a
              href={`${basePath}/tags/${tag}`}
              class="text-[11px] font-medium text-base-700 bg-base-200 hover:bg-base-300 hover:text-[#0071BB] px-2.5 py-0.5 rounded-full transition"
            >
              #{tag}
            </a>
          ))}
      </div>
    )}
  </div>
</article>
