---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allPosts = await getCollection("posts");
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())].filter(Boolean);
const sortedTags = tags.sort((a, b) => a.localeCompare(b));

const pageTitle = "Tags | Otaku";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout pageTitle={pageTitle}>
  <section class="py-12">
    <div class="max-w-xl">
      <h1 class="text-4xl text-balance font-medium font-display text-base-900">
        All tags
      </h1>
      <p class="mt-2 text-sm text-base-600">
        Browse posts by topic ({sortedTags.length} tags)
      </p>
    </div>
    <div class="flex flex-wrap gap-2.5 mt-8">
      {
        sortedTags.map((tag) => (
          <a
            class="text-xs font-medium text-base-800 bg-base-200 hover:bg-base-300 hover:text-[#0071BB] px-3.5 py-1.5 rounded-full border border-base-300 transition"
            href={`${basePath}/tags/${tag}`}
          >
            #{tag}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
