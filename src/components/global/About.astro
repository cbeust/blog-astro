---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-base-200 bg-white shadow-xs overflow-hidden ${className}`}>
  <div class="bg-[#f44365] px-4 py-2">
    <h4 class="text-[14px] font-normal uppercase tracking-[-0.04em] text-white">
      About
    </h4>
  </div>
  <div class="p-4 text-[13px] leading-relaxed text-base-800">
    My name is Cédric Beust. I created Android Gmail and the TestNG Java testing framework. This is my blog in which I discuss various software engineering topics.
  </div>
</div>
