---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopEntries from '@/components/global/TopEntries.astro';
import RecentPosts from '@/components/global/RecentPosts.astro';
import Archives from '@/components/global/Archives.astro';

const allPosts = await getCollection('posts');

// Sort chronologically descending (newest first)
allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout pageTitle="Archive | Otaku" description="Browse the complete post archive.">
  <div class="py-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <section class="lg:col-span-9 min-w-0">
      <div class="text-center mb-10">
      <h1 class="text-4xl font-medium font-display text-base-900 tracking-tight">
        Post Archive
      </h1>
      <p class="mt-2 text-sm text-base-600">
        Browsing all <strong class="text-base-900 font-semibold">{allPosts.length}</strong> posts.
      </p>

      <div class="mt-6">
        <input
          type="text"
          id="search-input"
          placeholder="Filter posts by title or tag..."
          autocomplete="off"
          class="block w-full max-w-md mx-auto px-4 py-2.5 text-sm rounded-full border border-base-300 bg-base-50 placeholder:text-base-500 text-base-900 focus:outline-none focus:ring-2 focus:ring-base-800 transition shadow-xs"
        />
      </div>
    </div>

    <div class="space-y-4" id="posts-list">
      {allPosts.map((post) => {
        const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });
        const commentCount = post.data.comments ? post.data.comments.length : 0;
        const searchString = `${post.data.title} ${post.data.tags?.join(' ') || ''}`.toLowerCase();

        return (
          <article
            class="post-item p-4 rounded-xl border border-base-200 hover:border-base-400 bg-base-50 transition flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-xs"
            data-search={searchString}
          >
            <div class="flex-grow">
              <h2 class="text-base font-medium text-base-900 leading-snug">
                <a href={`${basePath}/posts/${post.id}`} class="hover:text-[#0071BB] transition">
                  {post.data.title}
                </a>
              </h2>
              {post.data.tags?.filter((t: string) => t.toLowerCase() !== 'uncategorized').length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-1.5">
                  {post.data.tags
                    .filter((t: string) => t.toLowerCase() !== 'uncategorized')
                    .slice(0, 3)
                    .map((tag: string) => (
                      <a href={`${basePath}/tags/${tag}`} class="text-[11px] text-base-600 hover:text-[#0071BB]">
                        #{tag}
                      </a>
                    ))}
                </div>
              )}
            </div>

            <div class="flex items-center gap-3 text-xs text-base-500 shrink-0">
              <time datetime={new Date(post.data.pubDate).toISOString()}>{formattedDate}</time>
              {commentCount > 0 && <span>💬 {commentCount}</span>}
            </div>
          </article>
        );
      })}
    </div>

    <p id="no-results" class="text-center py-12 text-sm text-base-500" style="display: none;">
      No matching posts found.
    </p>
    </section>

    <!-- Right column: Top Entries, Recent Posts, and Archives -->
    <aside class="lg:col-span-3 space-y-6 mt-4 lg:mt-0">
      <TopEntries />
      <RecentPosts />
      <Archives />
    </aside>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const postsList = document.getElementById('posts-list');
  const noResults = document.getElementById('no-results');

  if (searchInput && postsList) {
    const items = postsList.querySelectorAll<HTMLElement>('.post-item');

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      items.forEach((item) => {
        const data = item.getAttribute('data-search') || '';
        if (!query || data.includes(query)) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  }
</script>
