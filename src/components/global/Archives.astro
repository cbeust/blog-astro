---
import { getCollection } from "astro:content";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const allPosts = await getCollection("posts");

// Extract all unique months from posts
const monthsMap = new Map<
  string,
  { year: string; month: string; label: string; time: number; count: number }
>();

for (const post of allPosts) {
  const d = new Date(post.data.pubDate);
  const year = String(d.getFullYear());
  const month = String(d.getMonth() + 1).padStart(2, "0");
  const key = `${year}/${month}`;
  if (!monthsMap.has(key)) {
    const monthName = d.toLocaleString("en-US", { month: "long" });
    monthsMap.set(key, {
      year,
      month,
      label: `${monthName} ${year}`,
      time: new Date(d.getFullYear(), d.getMonth(), 1).getTime(),
      count: 0,
    });
  }
  monthsMap.get(key)!.count++;
}

// Sort chronologically descending from the most recent ("February 2023") to the oldest ("August 2003")
const archiveMonths = Array.from(monthsMap.values()).sort(
  (a, b) => b.time - a.time
);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class={`rounded-xl border border-base-200 bg-white shadow-xs overflow-hidden ${className}`}>
  <div class="bg-[#f44365] px-4 py-2 border-b border-[#e02f51]">
    <h4 class="text-[14px] font-normal uppercase tracking-[-0.04em] text-white">
      Archives
    </h4>
  </div>
  <div class="p-4">
    <ul class="divide-y divide-base-100 -my-1 text-[13px] leading-[150%]">
      {archiveMonths.map((item) => (
        <li class="py-2 first:pt-0 last:pb-0">
          <a
            href={`${basePath}/${item.year}/${item.month}`}
            class="text-[#0071BB] hover:text-[#f44365] transition block"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
