---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Cta from "@/components/global/Cta.astro";
import { getCollection, render } from "astro:content";

const allPosts = await getCollection("posts");

// Sort chronologically descending (newest first)
allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const totalCount = allPosts.length;
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())]
  .filter(Boolean)
  .slice(0, 15);

// Get first five posts and pre-render their content in full
const firstFivePosts = allPosts.slice(0, 5);
const renderedPosts = await Promise.all(
  firstFivePosts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);
---

<BaseLayout pageTitle="Otaku — Cédric's Blog">
  <section class="py-12">
    <!-- Header banner -->
    <div class="mb-12">
      <h1 class="text-4xl sm:text-5xl font-medium font-display text-base-900 tracking-tight">
        Otaku
      </h1>
      <p class="mt-3 text-base text-base-600 max-w-xl leading-relaxed">
        Personal blog and archive by Cédric. Showing the latest 5 posts in full below.
      </p>

      {tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 mt-6 pt-6 border-t border-base-200">
          <span class="text-xs font-semibold uppercase tracking-wider text-base-400 mr-1">
            Topics:
          </span>
          {tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="text-xs font-medium text-base-600 hover:text-blue-600 bg-base-50 hover:bg-base-100 px-3 py-1 rounded-full border border-base-200 transition"
            >
              #{tag}
            </a>
          ))}
          <a
            href="/tags"
            class="text-xs font-medium text-blue-600 hover:underline px-2 py-1"
          >
            All tags →
          </a>
        </div>
      )}
    </div>

    <!-- First 5 Posts Rendered In Full -->
    <div class="space-y-16">
      {renderedPosts.map(({ post, Content }) => {
        const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        const commentsCount = post.data.comments?.length || 0;

        return (
          <article class="p-6 sm:p-8 rounded-2xl border border-base-200 bg-white shadow-xs">
            <header class="mb-6 pb-6 border-b border-base-100">
              <div class="flex items-center gap-2 text-xs text-base-400 mb-2">
                <span class="font-medium text-base-700">{post.data.author || 'Cédric'}</span>
                <span>&middot;</span>
                <time datetime={new Date(post.data.pubDate).toISOString()}>{formattedDate}</time>
                {commentsCount > 0 && (
                  <>
                    <span>&middot;</span>
                    <a href={`/posts/${post.id}#comments`} class="hover:text-blue-600 transition">
                      💬 {commentsCount} comments
                    </a>
                  </>
                )}
              </div>

              <h2 class="text-2xl sm:text-3xl font-medium font-display text-base-900 leading-snug">
                <a href={`/posts/${post.id}`} class="hover:text-blue-600 transition">
                  {post.data.title}
                </a>
              </h2>

              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {post.data.tags.map((tag: string) => (
                    <a
                      href={`/tags/${tag}`}
                      class="text-[11px] font-medium text-base-500 bg-base-50 hover:bg-base-100 px-2.5 py-0.5 rounded-full transition"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )}
            </header>

            <div class="prose prose-base max-w-none text-base-800 leading-relaxed">
              <Content />
            </div>

            <footer class="mt-8 pt-4 border-t border-base-100 flex items-center justify-between">
              <a
                href={`/posts/${post.id}`}
                class="text-xs font-semibold text-blue-600 hover:text-blue-800 transition"
              >
                Permalink & Discussion →
              </a>
              {commentsCount > 0 && (
                <a
                  href={`/posts/${post.id}#comments`}
                  class="text-xs text-base-400 hover:text-blue-600 transition"
                >
                  {commentsCount} {commentsCount === 1 ? 'comment' : 'comments'}
                </a>
              )}
            </footer>
          </article>
        );
      })}
    </div>

    <!-- Archive button link -->
    <div class="mt-16 text-center">
      <a
        href="/archive"
        class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-base-900 hover:bg-base-800 rounded-full transition duration-200 shadow-xs"
      >
        Browse all {totalCount} posts in the Archive →
      </a>
    </div>

    <Cta />
  </section>
</BaseLayout>
