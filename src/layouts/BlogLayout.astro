---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TopEntries from "@/components/global/TopEntries.astro";
import RecentPosts from "@/components/global/RecentPosts.astro";
import OtherContent from "@/components/global/OtherContent.astro";
import Archives from "@/components/global/Archives.astro";
import DateBadge from "@/components/DateBadge.astro";

interface Props {
  frontmatter: any;
  prevPost?: { id: string; title: string } | null;
  nextPost?: { id: string; title: string } | null;
}

const { frontmatter, prevPost, nextPost } = Astro.props;

const formattedDate = new Date(frontmatter.pubDate || frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const comments = frontmatter.comments || [];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout pageTitle={`${frontmatter.title} | Otaku`} description={frontmatter.description}>
  <div class="py-6">
    <div class="flex items-center justify-between gap-4 mb-4">
      <a href={`${basePath}/`} class="inline-flex items-center text-xs font-medium text-base-600 hover:text-[#0071BB] transition">
        ← Back to home
      </a>

      {(prevPost || nextPost) && (
        <nav aria-label="Post quick navigation" class="flex items-center gap-3 text-xs font-medium">
          {prevPost && (
            <a
              href={`${basePath}/posts/${prevPost.id}`}
              rel="prev"
              title={`Previous post: ${prevPost.title}`}
              class="text-base-600 hover:text-[#0071BB] transition flex items-center gap-1"
            >
              ← <span class="hidden sm:inline">Previous post</span><span class="sm:hidden">Prev</span>
            </a>
          )}
          {prevPost && nextPost && <span class="text-base-300">|</span>}
          {nextPost && (
            <a
              href={`${basePath}/posts/${nextPost.id}`}
              rel="next"
              title={`Next post: ${nextPost.title}`}
              class="text-base-600 hover:text-[#0071BB] transition flex items-center gap-1"
            >
              <span class="hidden sm:inline">Next post</span><span class="sm:hidden">Next</span> →
            </a>
          )}
        </nav>
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <article class="lg:col-span-9 min-w-0 p-6 sm:p-10 rounded-2xl border border-base-200 bg-base-50 shadow-xs">
      <header class="mb-10 pb-8 border-b border-base-200">
        <div class="flex items-start gap-4">
          <DateBadge date={frontmatter.pubDate || frontmatter.date} class="mt-1" />
          <div class="min-w-0 flex-1">
            <h1 class="text-3xl sm:text-4xl font-medium font-display text-base-900 leading-tight">
              {frontmatter.title}
            </h1>

            <div class="flex flex-wrap items-center justify-between gap-4 mt-3">
              <div class="text-xs text-base-500">
                {comments.length > 0 ? (
                  <a href="#comments" class="text-[#0071BB] hover:underline">
                    💬 {comments.length} {comments.length === 1 ? 'comment' : 'comments'}
                  </a>
                ) : (
                  <span>Comments off</span>
                )}
              </div>

              {frontmatter.tags?.filter((t: string) => t.toLowerCase() !== 'uncategorized').length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {frontmatter.tags
                    .filter((t: string) => t.toLowerCase() !== 'uncategorized')
                    .map((tag: string) => (
                      <a
                        href={`${basePath}/tags/${tag}`}
                        class="bg-base-200 hover:bg-base-300 hover:text-[#0071BB] text-base-700 px-2.5 py-1 rounded-full text-[11px] font-medium border border-base-300 transition"
                      >
                        #{tag}
                      </a>
                    ))}
                </div>
              )}
            </div>
          </div>
        </div>

        {frontmatter.description && (
          <p class="mt-4 text-base text-base-700 leading-relaxed">
            <em>{frontmatter.description}</em>
          </p>
        )}

        {frontmatter.image?.url && (
          <div class="mt-6 rounded-2xl overflow-hidden border border-base-200 shadow-xs">
            <Image
              width={1280}
              height={720}
              src={frontmatter.image.url}
              alt={frontmatter.image.alt || frontmatter.title}
              class="object-cover object-center w-full aspect-12/7"
            />
          </div>
        )}
      </header>

      <div class="prose prose-base max-w-none">
        <slot />
      </div>

      {(prevPost || nextPost) && (
        <nav aria-label="Post navigation" class="mt-12 pt-8 border-t border-base-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a
              href={`${basePath}/posts/${prevPost.id}`}
              rel="prev"
              class="group p-4 rounded-xl border border-base-200 hover:border-base-400 bg-base-100 hover:bg-base-200/50 transition flex flex-col justify-between"
            >
              <span class="text-xs font-semibold text-base-500 uppercase tracking-wider group-hover:text-[#0071BB] transition flex items-center gap-1">
                ← Previous Post
              </span>
              <span class="mt-2 text-sm font-medium text-base-900 group-hover:text-[#0071BB] transition line-clamp-2">
                {prevPost.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}

          {nextPost ? (
            <a
              href={`${basePath}/posts/${nextPost.id}`}
              rel="next"
              class="group p-4 rounded-xl border border-base-200 hover:border-base-400 bg-base-100 hover:bg-base-200/50 transition flex flex-col justify-between sm:text-right"
            >
              <span class="text-xs font-semibold text-base-500 uppercase tracking-wider group-hover:text-[#0071BB] transition flex items-center justify-start sm:justify-end gap-1">
                Next Post →
              </span>
              <span class="mt-2 text-sm font-medium text-base-900 group-hover:text-[#0071BB] transition line-clamp-2">
                {nextPost.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}
        </nav>
      )}

      {comments.length > 0 && (
        <section id="comments" class="mt-16 pt-10 border-t border-base-200">
          <h2 class="text-2xl font-medium font-display text-base-900 mb-8">
            Comments ({comments.length})
          </h2>

          <div class="space-y-6">
            {comments.map((comment: any) => (
              <div class="p-5 rounded-xl border border-base-200 bg-base-100 shadow-xs">
                <div class="flex items-center justify-between mb-3 text-xs">
                  <strong class="font-semibold text-base-900">{comment.author || 'Anonymous'}</strong>
                  <time class="text-base-500">
                    {comment.date ? new Date(comment.date).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    }) : ''}
                  </time>
                </div>
                <p class="text-sm text-base-800 whitespace-pre-line leading-relaxed">
                  {comment.content}
                </p>

                {comment.replies && comment.replies.length > 0 && (
                  <div class="mt-4 pl-4 border-l-2 border-base-300 space-y-4">
                    {comment.replies.map((reply: any) => (
                      <div class="p-4 rounded-lg bg-base-50 border border-base-200">
                        <div class="flex items-center justify-between mb-2 text-xs">
                          <strong class="font-semibold text-base-900">{reply.author || 'Anonymous'}</strong>
                          <time class="text-base-500">
                            {reply.date ? new Date(reply.date).toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                            }) : ''}
                          </time>
                        </div>
                        <p class="text-sm text-base-800 whitespace-pre-line leading-relaxed">
                          {reply.content}
                        </p>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>

          {(prevPost || nextPost) && (
            <div class="mt-10 pt-6 border-t border-base-200 flex items-center justify-between text-xs font-medium text-base-600">
              {prevPost ? (
                <a
                  href={`${basePath}/posts/${prevPost.id}`}
                  rel="prev"
                  class="hover:text-[#0071BB] transition flex items-center gap-1 max-w-[45%]"
                >
                  ← Previous: <span class="truncate">{prevPost.title}</span>
                </a>
              ) : (
                <span />
              )}
              {nextPost ? (
                <a
                  href={`${basePath}/posts/${nextPost.id}`}
                  rel="next"
                  class="hover:text-[#0071BB] transition flex items-center gap-1 text-right max-w-[45%] ml-auto justify-end"
                >
                  Next: <span class="truncate">{nextPost.title}</span> →
                </a>
              ) : (
                <span />
              )}
            </div>
          )}
        </section>
      )}
    </article>

      <!-- Right column: Top Entries, Recent Posts, Other Content, and Archives -->
      <aside class="lg:col-span-3 space-y-6 mt-4 lg:mt-0">
        <TopEntries />
        <RecentPosts />
        <OtherContent />
        <Archives />
      </aside>
    </div>
  </div>
</BaseLayout>
