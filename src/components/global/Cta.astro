---
---
<section class="bg-base-50 p-8 rounded-xl lg:p-16 mt-16 border border-base-200">
  <h2
    id="newsletter-heading"
    class="text-2xl text-balance font-medium font-display text-base-900 text-center"
  >
    Stay updated with Otaku
  </h2>
  <p class="text-sm text-base-500 text-center mt-2 max-w-sm mx-auto">
    Subscribe via RSS or follow along for articles on development, software engineering, and reflections.
  </p>

  <form
    action=""
    method="post"
    class="mt-8"
    aria-label="Newsletter signup form"
    onsubmit="event.preventDefault()"
  >
    <div class="flex flex-col w-full max-w-md mx-auto gap-3 sm:flex-row">
      <label for="email" class="sr-only">Email address</label>
      <input
        id="email"
        name="email"
        type="email"
        class="block w-full h-10 px-4 py-2 text-sm font-medium rounded-full border border-base-200 text-base-900 placeholder-base-400 focus:border-base-800 focus:outline-none focus:ring-2 focus:ring-base-700/50 bg-white"
        placeholder="Enter your email..."
        required
      />

      <button
        type="submit"
        class="flex items-center justify-center h-10 px-6 py-2 text-sm text-white bg-base-900 rounded-full duration-300 hover:bg-base-800 shrink-0 font-medium cursor-pointer"
      >
        Subscribe
      </button>
    </div>
  </form>
</section>
