---
import BaseHead from "@/components/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";

interface Props {
  pageTitle?: string;
  description?: string;
}

const { pageTitle, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={description} />
  </head>
  <body class="flex flex-col max-w-4xl min-h-screen px-6 sm:px-8 mx-auto bg-white text-base-900 antialiased font-sans">
    <Navigation />
    <main class="flex-grow"><slot /></main>
    <Footer />
  </body>
</html>
