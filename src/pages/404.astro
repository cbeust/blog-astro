---
import BaseLayout from "@/layouts/BaseLayout.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout pageTitle="Page Not Found | Otaku">
  <div class="py-24 text-center">
    <h1 class="text-5xl font-display font-medium text-base-900 mb-4">404</h1>
    <p class="text-base-500 mb-8">Page not found.</p>
    <a href={`${basePath}/`} class="text-sm font-medium text-blue-600 hover:underline">
      ← Return to home
    </a>
  </div>
</BaseLayout>
