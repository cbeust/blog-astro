---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header id="header-wrap" class="w-full relative z-10 shadow-md">
  <div id="header" class="w-full">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 pb-5">
      <!-- Title & Tagline -->
      <div id="pagetitle" class="flex flex-col md:flex-row md:items-center gap-2 md:gap-0">
        <h1 class="logo text-3xl sm:text-4xl md:text-5xl">
          <a href={`${basePath}/`}>
            OTAKU - CÉDRIC'S BLOG
          </a>
        </h1>
        <h4 class="tagline text-lg sm:text-xl md:text-2xl md:border-l md:border-[#8e7762] md:pl-4 md:ml-4 leading-snug">
          Thoughts on software engineering
        </h4>
      </div>

      <!-- Navigation links -->
      <nav class="mt-6 pt-3 border-t border-[#8e7762]/40 flex items-center justify-between text-sm">
        <div class="flex items-center gap-6 font-bold tracking-wide">
          <a
            href={`${basePath}/`}
            class="text-[#b5d1e6] hover:text-white transition drop-shadow-[0_1px_1px_rgba(0,0,0,0.4)]"
          >
            Home
          </a>
          <a
            href={`${basePath}/archive`}
            class="text-[#b5d1e6] hover:text-white transition drop-shadow-[0_1px_1px_rgba(0,0,0,0.4)]"
          >
            Archive
          </a>
          <a
            href={`${basePath}/tags`}
            class="text-[#b5d1e6] hover:text-white transition drop-shadow-[0_1px_1px_rgba(0,0,0,0.4)]"
          >
            Tags
          </a>
          <a
            href={`${basePath}/rss.xml`}
            class="text-[#b5d1e6] hover:text-white transition drop-shadow-[0_1px_1px_rgba(0,0,0,0.4)]"
          >
            RSS
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>
