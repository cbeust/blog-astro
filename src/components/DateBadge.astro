---
interface Props {
  date: string | Date;
  size?: "sm" | "md" | "lg";
  showYear?: boolean;
  class?: string;
}

const { date, size = "md", showYear = true, class: className = "" } = Astro.props;

let d: Date;
if (date instanceof Date) {
  d = date;
} else if (typeof date === "string") {
  // If date string is formatted like "YYYY-MM-DD", parse as local date to prevent timezone shift
  if (/^\d{4}-\d{2}-\d{2}$/.test(date)) {
    const [y, m, dayNum] = date.split("-").map(Number);
    d = new Date(y, m - 1, dayNum);
  } else {
    d = new Date(date);
  }
} else {
  d = new Date();
}

const isValid = !isNaN(d.getTime());

// Month: 3-letter abbreviation e.g. "Feb"
const month = isValid
  ? d.toLocaleDateString("en-US", { month: "short" })
  : "";

// Day: day of month number e.g. "9"
const day = isValid
  ? d.toLocaleDateString("en-US", { day: "numeric" })
  : "";

// Year: 4-digit year e.g. "2023"
const year = isValid
  ? d.toLocaleDateString("en-US", { year: "numeric" })
  : "";

const fullDate = isValid
  ? d.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : String(date);

const isoDate = isValid ? d.toISOString() : "";

const sizeClasses = {
  sm: showYear ? "w-[36px] min-h-[42px]" : "w-[36px] h-[36px]",
  md: showYear ? "w-[40px] min-h-[48px]" : "w-[40px] h-[40px]",
  lg: showYear ? "w-[48px] min-h-[58px]" : "w-[48px] h-[48px]",
}[size] || (showYear ? "w-[40px] min-h-[48px]" : "w-[40px] h-[40px]");

const monthTextClasses = {
  sm: "text-[8.5px] leading-[13px] tracking-wider",
  md: "text-[9.5px] leading-[15px] tracking-wider",
  lg: "text-[11px] leading-[18px] tracking-wider",
}[size] || "text-[9.5px] leading-[15px] tracking-wider";

const dayTextClasses = {
  sm: showYear ? "text-[12px]" : "text-[14px]",
  md: showYear ? "text-[14px]" : "text-[16px]",
  lg: showYear ? "text-[17px]" : "text-[20px]",
}[size] || (showYear ? "text-[14px]" : "text-[16px]");

const yearTextClasses = {
  sm: "text-[7.5px] leading-tight pb-0.5",
  md: "text-[8.5px] leading-tight pb-1",
  lg: "text-[10px] leading-tight pb-1.5",
}[size] || "text-[8.5px] leading-tight pb-1";
---

<time
  datetime={isoDate}
  title={fullDate}
  class={`post-date ${showYear ? "has-year !h-auto" : ""} inline-flex flex-col ${sizeClasses} shrink-0 rounded-[3px] overflow-hidden border border-[#d6cfb8] bg-white shadow-[0_1px_2px_rgba(0,0,0,0.08)] text-center select-none ${className}`}
>
  <span
    class={`month block bg-[#f44365] text-white font-bold uppercase border-b border-white ${monthTextClasses}`}
  >
    {month}
  </span>
  <span
    class={`day flex-1 flex items-center justify-center bg-white text-black font-bold leading-none ${dayTextClasses} ${showYear ? "pt-0.5" : ""}`}
  >
    {day}
  </span>
  {showYear && (
    <span
      class={`year block bg-white text-[#6E6255] font-semibold leading-none tracking-tight ${yearTextClasses}`}
    >
      {year}
    </span>
  )}
</time>
